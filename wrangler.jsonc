{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appm2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "eb05f0d9-355b-4bae-bf37-5db3b8973093","database_name": "web-appm2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "80e3adc8a85a4ecba9562a7a7cc08144" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
